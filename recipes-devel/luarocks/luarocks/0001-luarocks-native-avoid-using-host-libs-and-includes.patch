From a0189371e103d9f9828378f0cf2848334e28b727 Mon Sep 17 00:00:00 2001
From: Christian Hohnstaedt <christian@hohnstaedt.de>
Date: Sat, 28 Jun 2025 12:04:31 +0200
Subject: [PATCH 1/4] luarocks-native: avoid using host libs and includes

luarocks now ignores lua.h in /usr/include,
as well as libs in /usr/lib

Upstream-Status: Inappropriate [oer specific]
---
 src/luarocks/build/builtin.lua | 2 --
 1 file changed, 2 deletions(-)

diff --git a/src/luarocks/build/builtin.lua b/src/luarocks/build/builtin.lua
index 48b3c19d..5558eb55 100644
--- a/src/luarocks/build/builtin.lua
+++ b/src/luarocks/build/builtin.lua
@@ -231,12 +231,10 @@ function builtin.run(rockspec, no_install)
       compile_object = function(object, source, defines, incdirs)
          local extras = {}
          add_flags(extras, "-D%s", defines)
-         add_flags(extras, "-I%s", incdirs)
          return execute(variables.CC .. " " .. variables.CFLAGS, "-I" .. variables.LUA_INCDIR, "-c", source, "-o", object, _tl_table_unpack(extras))
       end
       compile_library = function(library, objects, libraries, libdirs)
          local extras = { _tl_table_unpack(objects) }
-         add_flags(extras, "-L%s", libdirs)
          if cfg.gcc_rpath then
             add_flags(extras, "-Wl,-rpath,%s", libdirs)
          end
-- 
