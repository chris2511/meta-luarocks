From a958f129c4242a967a17d0f14373c009c5760cc5 Mon Sep 17 00:00:00 2001
From: Bruno Thiago <45828157+brunotvs@users.noreply.github.com>
Date: Tue, 17 Mar 2026 12:48:34 -0300
Subject: [PATCH 2/4] fix: correctly handling wrap_bin_scripts flag (#1866)

Fixes #1827.

Upstream-Status: Backport
---
 src/luarocks/core/cfg.lua | 1 +
 src/luarocks/repos.lua    | 3 +--
 src/luarocks/repos.tl     | 3 +--
 3 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/src/luarocks/core/cfg.lua b/src/luarocks/core/cfg.lua
index 1c380e1d..a1dbb69f 100644
--- a/src/luarocks/core/cfg.lua
+++ b/src/luarocks/core/cfg.lua
@@ -187,6 +187,7 @@ local function make_defaults(lua_version, target_cpu, platforms, home)
       deps_mode = "one",
       no_manifest = false,
       check_certificates = false,
+      wrap_bin_scripts = true,
 
       cache_timeout = 60,
       cache_fail_timeout = 86400,
diff --git a/src/luarocks/repos.lua b/src/luarocks/repos.lua
index e283301c..5bd8e4f1 100644
--- a/src/luarocks/repos.lua
+++ b/src/luarocks/repos.lua
@@ -196,8 +196,7 @@ function repos.run_hook(rockspec, hook_name)
 end
 
 function repos.should_wrap_bin_scripts(rockspec)
-
-   if cfg.wrap_bin_scripts then
+   if type(cfg.wrap_bin_scripts) == "boolean" then
       return cfg.wrap_bin_scripts
    end
    if rockspec.deploy and rockspec.deploy.wrap_bin_scripts == false then
diff --git a/src/luarocks/repos.tl b/src/luarocks/repos.tl
index 93c85d9a..4d38a3c3 100644
--- a/src/luarocks/repos.tl
+++ b/src/luarocks/repos.tl
@@ -196,8 +196,7 @@ function repos.run_hook(rockspec: Rockspec, hook_name: string): boolean, string
 end
 
 function repos.should_wrap_bin_scripts(rockspec: Rockspec): boolean
-
-   if cfg.wrap_bin_scripts then
+   if type(cfg.wrap_bin_scripts) == "boolean" then
       return cfg.wrap_bin_scripts
    end
    if rockspec.deploy and rockspec.deploy.wrap_bin_scripts == false then
-- 
2.39.5

