diff --git a/ldoc/markdown.lua b/ldoc/markdown.lua
index 86d5c86a..4d846954 100644
--- a/ldoc/markdown.lua
+++ b/ldoc/markdown.lua
@@ -824,8 +824,8 @@ end
 local function unescape_special_chars(t)
 	local tin = t
 	for k,v in pairs(escape_table) do
-		k = k:gsub("%%", "%%%%")
-		t = t:gsub(v,k)
